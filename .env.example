# ─── Telegram ────────────────────────────────────────────────────────────────
# Jeton donné par @BotFather quand tu crées le bot.
TELEGRAM_BOT_TOKEN=
# Ton identifiant de conversation (voir README, étape « Récupérer son chat_id »).
TELEGRAM_CHAT_ID=
# Chaîne aléatoire de ton choix (lettres, chiffres, _ et -) : protège le webhook
# des commandes /brief et /watchlist. Exemple : openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# ─── IA (au moins une clé ; essayées dans cet ordre) ─────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Modèles (facultatif : valeurs par défaut ci-dessous)
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free

# ─── Données de marché (Stooq ne demande pas de clé) ─────────────────────────
# https://twelvedata.com/apikey  — ETF Euronext Paris et secours actions US
TWELVEDATA_API_KEY=
# https://www.alphavantage.co/support/#api-key — secours (25 requêtes / jour)
ALPHAVANTAGE_API_KEY=
# https://finnhub.io/dashboard — calendrier des résultats + secours actions US
FINNHUB_API_KEY=

# ─── Web app ─────────────────────────────────────────────────────────────────
# URL publique de l'app Vercel (lien « Ouvrir l'app » dans le message Telegram).
APP_URL=
# URL du dépôt GitHub affichée sur la page /projet.
NEXT_PUBLIC_GITHUB_URL=
